# ---------------------------------------------------------------------------
# Appearance
# ---------------------------------------------------------------------------

font-family = Monaco
font-size = 12

theme = Ayu Mirage
window-colorspace = display-p3
background = 1f1f28
macos-titlebar-style = tabs
desktop-notifications = true

cursor-style = block
cursor-style-blink = true
cursor-color = e66b2a

split-divider-color = #4a4a55

window-padding-x = 4
window-padding-y = 4

# ---------------------------------------------------------------------------
# Behavior
# ---------------------------------------------------------------------------

# Keep the configured block cursor at the shell prompt too.
shell-integration-features = no-cursor

copy-on-select = clipboard

# 50MB
scrollback-limit = 50_000_000

# Required for the alt+... bindings below. Defaults to true only on U.S.
# layouts, so pin it.
macos-option-as-alt = true

# splits and tabs always open in the current directory
window-inherit-working-directory = true
# open the new tab right after the current one
window-new-tab-position = current

# Make Shift+Enter insert a newline in terminal TUIs
keybind = shift+enter=text:\n


# ---------------------------------------------------------------------------
# Direct bindings (no prefix)
# ---------------------------------------------------------------------------

# window traversal: Cmd+Shift+h/l, Alt+Shift+e
keybind = super+shift+h=previous_tab
keybind = super+shift+l=next_tab
keybind = alt+shift+e=last_tab

# pane traversal: Alt+h/j/k/l
keybind = alt+h=goto_split:left
keybind = alt+j=goto_split:down
keybind = alt+k=goto_split:up
keybind = alt+l=goto_split:right

# Quick terminal: a global dropdown terminal. Prefix with `global:` to make it
# work when Ghostty is not focused (needs Accessibility permission).
keybind = alt+shift+p=toggle_quick_terminal


# ---------------------------------------------------------------------------
# Prefix bindings (ctrl+b, as a key sequence)
# ---------------------------------------------------------------------------

# send a literal C-b through to the program
keybind = ctrl+b>ctrl+b=text:\x02

# --- panes / splits ---
keybind = ctrl+b>shift+quote=new_split:down
keybind = ctrl+b>shift+digit_5=new_split:right
keybind = ctrl+b>z=toggle_split_zoom
keybind = ctrl+b>x=close_surface
keybind = ctrl+b>equal=equalize_splits

# --- windows / tabs ---
keybind = ctrl+b>c=new_tab
keybind = ctrl+b>shift+arrow_left=move_tab:-1
keybind = ctrl+b>shift+arrow_right=move_tab:+1

# --- misc ---
keybind = ctrl+b>r=reload_config

# Entry point
keybind = ctrl+b>[=activate_key_table:vim

# Key table definition
keybind = vim/

# Line movement
keybind = vim/j=scroll_page_lines:1
keybind = vim/k=scroll_page_lines:-1

# Page movement
keybind = vim/ctrl+d=scroll_page_down
keybind = vim/ctrl+u=scroll_page_up

# Jump to top/bottom
keybind = vim/g>g=scroll_to_top
keybind = vim/shift+g=scroll_to_bottom

# Search (if you want vim-style search entry)
keybind = vim/slash=start_search
keybind = vim/n=navigate_search:next
keybind = vim/shift+n=navigate_search:previous

# Copy mode / selection
# Note we're missing a lot of actions here to make this more full featured.
keybind = vim/y=copy_to_clipboard

# Command Palette
keybind = vim/shift+semicolon=toggle_command_palette

# Exit
keybind = vim/escape=deactivate_key_table
keybind = vim/q=deactivate_key_table
keybind = vim/i=deactivate_key_table

# Catch unbound keys
keybind = vim/catch_all=ignore
